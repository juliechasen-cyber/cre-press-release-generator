# Anthropic — drives the LLM generation step
ANTHROPIC_API_KEY=

# Resend — transactional email for the "Email it to me" flow
# Get a key at resend.com; verify your sending domain before production
RESEND_API_KEY=
RESEND_FROM=drafts@yourdomain.com
RESEND_REPLY_TO=hello@yourdomain.com

# Public site URL for the "Powered by CRE Northstar" link and email footers
NEXT_PUBLIC_SITE_URL=https://crenorthstar.com

# Google Apps Script Web App URLs for lead capture (both optional — if unset,
# capture silently no-ops). Each points at a deployed Apps Script bound to a
# Google Sheet. See docs/lead-capture-setup.md for setup steps.
# GENERATE_WEBHOOK fires whenever a draft is successfully generated.
# EMAIL_WEBHOOK fires whenever a user submits the "Email it to me" form.
GENERATE_WEBHOOK=
EMAIL_WEBHOOK=
